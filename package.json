{
  "name": "simplistic-tetris",
  "version": "3.3.0",
  "description": "Simplistic Tetris - Retro Tetris game made with TypeScript. Play Tetris anywhere, anytime. Have a break play Tetris!",
  "type": "module",
  "main": "index.html",
  "author": "Kevin Alves (KevOneRedOne)",
  "license": "MIT",
  "homepage": "https://simplistic-tetris.netlify.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/KevOneRedOne/Simplistic-Tetris.git"
  },
  "bugs": {
    "url": "https://github.com/KevOneRedOne/Simplistic-Tetris/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=11.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.2"
    }
  },
  "dependencies": {
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "canvas": "^3.2.3",
    "commitlint": "^21.2.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "tetris",
    "typescript",
    "canvas",
    "game",
    "vite"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{scss,css,json}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/update-sitemap.js && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss,css,json}\"",
    "prepare": "husky",
    "sitemap:update": "node scripts/update-sitemap.js",
    "docker:build": "docker build -t simplistic-tetris:latest .",
    "docker:run": "docker run -d --name simplistic-tetris -p 8080:80 simplistic-tetris:latest",
    "docker:stop": "docker stop simplistic-tetris",
    "docker:build:run": "pnpm docker:build && docker stop simplistic-tetris 2>/dev/null || true && docker rm simplistic-tetris 2>/dev/null || true && pnpm docker:run"
  },
  "files": [
    "dist",
    "public",
    "index.html"
  ]
}
